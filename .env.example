# ============================================
# WhiteNote environment configuration
# Copy to .env and fill in values.
# Nested config uses double underscore (__).
# ============================================

# ----- Data directory (all persistent state lives here) -----
# Everything you'd want to back up or move lives under this folder:
#   $DATA_DIR/postgres  $DATA_DIR/redis  $DATA_DIR/qdrant
#   $DATA_DIR/cache     $DATA_DIR/logs
# Run `mkdir -p $DATA_DIR/{postgres,redis,qdrant,cache,logs}` before the first up.
DATA_DIR=./data

# ----- Core services (point app containers at compose-internal hostnames) -----
DATABASE_URL=postgresql://whitenote:whitenote_password@postgres:5432/whitenote
REDIS__HOST=redis
REDIS__PORT=6379
QDRANT_DATABASE__HOST=qdrant

# ----- LLM (LiteLLM, used for translation / summary / chat) -----
CHAT_LITELLM__MODEL=gpt-4o-mini
CHAT_LITELLM__API_KEY=sk-...
CHAT_LITELLM__API_BASE=https://api.openai.com/v1

# ----- Gemini (used for comic generation) -----
GEMINI__API_KEY=

# ----- Zotero (used by MCP `save_to_zotero` tool) -----
# Get API key:  https://www.zotero.org/settings/keys
# Library ID:   numeric user ID (or group ID) shown on the keys page
ZOTERO__API_KEY=
ZOTERO__LIBRARY_ID=
ZOTERO__LIBRARY_TYPE=user
ZOTERO__DEFAULT_COLLECTION=

# ----- MCP server bind (host side) -----
# 127.0.0.1 = local agents only (default).
# Set to 0.0.0.0 to expose to your LAN. Only do this if you set up auth.
MCP_BIND=127.0.0.1
